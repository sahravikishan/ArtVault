# ─────────────────────────────────────────────────────────────
# ArtVault — Environment Variables Configuration
# Copy this file to .env and provide your secret credentials.
# ─────────────────────────────────────────────────────────────

# Django Core
SECRET_KEY=django-insecure-artvault-secret-key-change-in-production-2024
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Payment Gateway (Razorpay)
# Obtain test/live API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret

# Email Configuration
# Development default is console email backend (prints to terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Production SMTP (e.g. Gmail / SendGrid / AWS SES):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=curator@artvault.in
# EMAIL_HOST_PASSWORD=your_app_password_here
# DEFAULT_FROM_EMAIL=ArtVault Curatorial Concierge <noreply@artvault.in>
# ARTVAULT_ADMIN_EMAIL=curator@artvault.in
